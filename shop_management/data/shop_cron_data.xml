<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="cron_shop_stock_email" model="ir.cron">
            <field name="name">Shop : Available Items</field>
            <field name="model_id" ref="model_shop_item"/>
            <field name="state">code</field>
            <field name="code">model._cron_available_send_email()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>