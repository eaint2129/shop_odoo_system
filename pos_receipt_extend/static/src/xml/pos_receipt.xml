<?xml version="1.0" encoding="UTF-8" ?>
<template id="template" xml:space="preserve">
    <t t-name="pos_receipt_extend.ReceiptHeader" t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt-contact')]" position="after">
            <div t-if="order.partner_id" class="pos-receipt-customer mt-2">
                Customer : <t t-esc="order.partner_id.name"/>
            </div>
        </xpath>
    </t>
    <t t-name="pos_receipt_extend.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('after-footer')]" position="after">
            <div class="pos-receipt-center-align pt-3 text-center">
                You have earned : <t t-esc="order.loyaltyPoints"/> points.
            </div>
        </xpath>
    </t>
</template>